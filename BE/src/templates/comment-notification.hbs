<!DOCTYPE html>
<html>
<head><meta charset="utf-8"><title>New Reply</title></head>
<body style="font-family: sans-serif; color: #333; max-width: 600px; margin: 0 auto; padding: 20px;">
  <h2 style="color: #4f46e5;">New reply on your ticket</h2>
  <p>Hi {{userName}},</p>
  <p><strong>{{agentName}}</strong> replied to your ticket <strong>{{ticketSubject}}</strong>:</p>
  <div style="background: #f9fafb; border-left: 4px solid #4f46e5; padding: 16px; margin: 20px 0; border-radius: 4px; white-space: pre-wrap;">{{commentBody}}</div>
  <p><a href="{{portalUrl}}" style="background: #4f46e5; color: white; padding: 10px 20px; text-decoration: none; border-radius: 6px; display: inline-block;">View Ticket</a></p>
  <hr style="border: none; border-top: 1px solid #e5e7eb; margin: 30px 0;">
  <p style="font-size: 12px; color: #9ca3af;">SupportDesk Pro</p>
</body>
</html>
